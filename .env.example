# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Required — create a GitHub personal access token with repo + issues scope
# https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Required — create a free Reddit app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# Optional — improves Trustpilot rate limits but public reviews work without it
TRUSTPILOT_API_KEY=
